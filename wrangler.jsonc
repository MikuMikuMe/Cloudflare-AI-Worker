{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucky-salad-6e38",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "a0af41818e1b715f66046b0d7870ce70",

  "observability": {
    "enabled": true
  },

  // Refresh the existing D1-backed NVIDIA free-endpoint index once per day.
  // This is a trigger on the current Worker, not a new service.
  "triggers": {
    "crons": ["0 0 * * *"]
  },

  // Workers AI - already present on the original Worker, no new cost surface.
  "ai": {
    "binding": "AI"
  },

  // Managed Cloudflare Web Search is zero-setup and discovery-only. The Worker
  // fetches the returned public URLs itself; no crawler instance is created.
  // This account currently reports the experimental binding as account_disabled,
  // so SEARXNG_URL remains an optional fallback until Cloudflare enables it.
  "websearch": {
    "binding": "WEBSEARCH",
    "remote": true
  },

  // AI Search - the configured web-crawler instance for the existing app domain.
  // The direct instance binding keeps the Worker scoped to this one resource.
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "lofuyu-web-search",
      "remote": true
    }
  ],

  // D1 stores API key hashes + usage counters. Free tier: 5GB / 5M reads / 100k writes per day.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfai-db",
      "database_id": "0e93efd9-7ddd-4442-8933-68b4d75832d1",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Public account identifier used only to address the existing Cloudflare account.
    "CLOUDFLARE_ACCOUNT_ID": "a0af41818e1b715f66046b0d7870ce70",

    // Default model used when a client sends an unknown/OpenAI-style model name.
    "DEFAULT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",

    // Existing Workers AI model used for the default web-search planning turn.
    // This model is documented by Cloudflare as supporting traditional function calling.
    "WEB_SEARCH_MODEL": "@cf/openai/gpt-oss-20b",

    // Set SEARXNG_URL outside this file only when a SearXNG-compatible JSON endpoint is approved.
    // Do not point production at an arbitrary public instance without reviewing its terms and reliability.

    // --- Cloudflare Access (Zero Trust) ---
    // Until BOTH of these are set, /admin is fail-closed and returns setup instructions.
    // Existing Zero Trust team used by the Access application.
    "ACCESS_TEAM_DOMAIN": "cosmiclatte.cloudflareaccess.com",
    // ACCESS_AUD is the Application Audience (AUD) tag of the Access application.
    "ACCESS_AUD": "e3e783e9325f85a45622c24467e4bd6a06abe172530fb1a31045e3e9b9617cf3"
  },

  "routes": [
    {
      "pattern": "ai.lofuyu.com",
      "custom_domain": true
    }
  ],

  "workers_dev": true
}
