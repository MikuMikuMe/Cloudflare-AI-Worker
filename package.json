{
  "name": "cloudflare-ai-worker",
  "version": "2.1.0",
  "private": true,
  "description": "OpenAI-compatible AI gateway on Cloudflare Workers, with Cloudflare Access SSO and self-service API keys",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply cfai-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply cfai-db --local",
    "test:openai": "node scripts/verify-openai-sdk.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "openai": "^4.77.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.120.0"
  }
}
